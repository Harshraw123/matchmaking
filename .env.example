# ==============================================================================
# The Date Crew (TDC) — Matchmaker Workspace Environment Configuration
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication Session Secret (used for signing secure HTTP-only cookies)
SESSION_SECRET=the-date-crew-matchmaker-session-secret-2026

# PostgreSQL Database (Drizzle ORM)
# Optional in development/demo mode: If omitted or unreachable, the application 
# runs seamlessly with its high-performance in-memory/seed demo store.
DATABASE_URL=postgresql://postgres:password@localhost:5432/matchmaker

# Google Gemini API Key (Server-side Only — Recommended)
# Supports Gemini 2.5 Flash / 1.5 Flash for high-speed grounded matchmaker rationale synthesis
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (Optional Alternative)
# If GEMINI_API_KEY is not set, this fallback is engaged.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
